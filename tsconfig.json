{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@autoplay/shared": ["./packages/shared/dist/index.d.ts"],
      "@autoplay/streaming": ["./packages/streaming/dist/index.d.ts"],
      "@autoplay/game-adapter-sdk": ["./packages/game-adapters/adapter-sdk/dist/index.d.ts"],
      "@autoplay/adapter-sdk": ["./packages/game-adapters/adapter-sdk/dist/index.d.ts"],
      "@autoplay/adapter-subway-surfers": ["./packages/game-adapters/subway-surfers/dist/index.d.ts"],
      "@autoplay/adapter-pokemon-red": ["./packages/game-adapters/pokemon-red/dist/index.d.ts"],
      "@autoplay/session-manager": ["./packages/session-manager/dist/index.d.ts"],
      "@autoplay/capture": ["./packages/capture/dist/index.d.ts"],
      "@autoplay/overlay": ["./packages/overlay/dist/index.d.ts"],
      "@autoplay/scheduler": ["./services/scheduler/dist/index.d.ts"],
      "@autoplay/monitoring": ["./services/monitoring/dist/index.d.ts"],
      "@autoplay/chat-interactivity": ["./packages/chat-interactivity/dist/index.d.ts"]
    }
  },
  "include": [
    "vitest.config.ts",
    "tests/**/*.ts"
  ]
}
