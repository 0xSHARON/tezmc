# AutoPlay AI Environment Configuration Example
# Copy this file to .env and configure for your environment.

# Server & Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# Security & Authentication
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Persistence
# For SQLite (default development):
DATABASE_URL=file:./data/autoplay.sqlite
# For PostgreSQL (production):
# DATABASE_URL=postgresql://autoplay_user:password@localhost:5432/autoplay_db

# YouTube Live Streaming Ingest
# The RTMP ingest endpoint for YouTube Live (primary: rtmp://a.rtmp.youtube.com/live2)
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
# YouTube Live Stream Key (WRITE-ONLY - Do not commit or log)
YOUTUBE_STREAM_KEY=
# YouTube Data API v3 (Optional for automated broadcast title/health metadata)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Local RTMP Ingest Test Target (Used for local CI and local test mode)
LOCAL_RTMP_URL=rtmp://localhost:1935/live/test

# Stream Video & Audio Encoding Parameters
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=30
STREAM_VIDEO_BITRATE=2500k
STREAM_AUDIO_BITRATE=128k
STREAM_KEYFRAME_INTERVAL=2
STREAM_PRESET=veryfast

# Autonomous Session Limits & Protection
MAX_RESTART_ATTEMPTS=5
MAX_SESSION_HOURS=24
CRASH_LOOP_WINDOW_MINUTES=15
RECOVERY_COOLDOWN_SECONDS=10

# Minecraft Java Adapter Settings
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565
MINECRAFT_VERSION=1.20.1
MINECRAFT_BOT_NAME=AutoPlayBot
MINECRAFT_AUTH=offline
MINECRAFT_VIEWER_PORT=3007

# Hardware / Resource Limits
MAX_CPU_PERCENT=85
MAX_MEMORY_PERCENT=85
MIN_DISK_FREE_MB=2048
