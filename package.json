{
  "name": "tezmc",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "TEZMC — Autonomous Gaming & Live Streaming Platform",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @autoplay/api run dev",
    "dev:dashboard": "pnpm --filter @autoplay/dashboard run dev",
    "start": "node apps/api/dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "autonomous-gaming",
    "mineflayer",
    "youtube-live",
    "ffmpeg",
    "obs",
    "game-streaming"
  ],
  "author": "TEZMC Core Team",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "recharts": "^3.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
