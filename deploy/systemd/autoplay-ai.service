[Unit]
Description=AutoPlay AI Autonomous Game Bot & Streaming Service
After=network.target

[Service]
Type=simple
User=autoplay
WorkingDirectory=/opt/autoplay-ai
Environment=NODE_ENV=production
EnvironmentFile=/opt/autoplay-ai/.env
ExecStart=/usr/bin/node apps/api/dist/index.js
Restart=always
RestartSec=10
LimitNOFILE=65535

# Security sandboxing
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
